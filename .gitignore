# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
# Credentials the framework probe needs to run (SPEC-v0.4 §7). Kept out of the index because
# `git add -A` does not ask: this file was staged once, and only GitHub's push protection
# stood between it and a public commit.
.env
.env.*
!.env.example

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage

# CTRLRun local state (SPEC-v0.1 §5, §6)
.ctrlrun/
# Anchored: this ignores the operator's own policy at the repo root, which `ctrlrun init`
# writes. Unanchored it matched every `ctrlrun.yaml` at any depth, which silently kept the
# examples' policy files out of a commit — they worked locally and were missing from every
# clone. `test_T31_every_file_an_example_needs_is_tracked_by_git` is the guard.
/ctrlrun.yaml

# OS
.DS_Store
